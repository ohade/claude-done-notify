<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template rendered by install.sh.
    Placeholders:
      __PYTHON__     — absolute path to python3, detected via `command -v python3`
      __SCRIPT_DIR__ — absolute path to claude-done-notify checkout
      __LOG_DIR__    — absolute path to ~/.claude/hooks (created by install.sh)
    Do not load this file directly via launchctl. Run install.sh, which writes
    the rendered plist to ~/Library/LaunchAgents/com.ohad.cmux-focus.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ohad.cmux-focus</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SCRIPT_DIR__/cmux-focus-server.py</string>
    </array>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/cmux-focus.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/cmux-focus.err.log</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
